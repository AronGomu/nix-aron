# Copy to ~/.pi/agent/configs/.env and fill real values.
# Loaded by pikit env-loader into pi sessions, and by shell init for CLI tools.
# NEVER commit .env

# xAI / Grok (chat via pi OAuth may already work; API key needed for Imagine + grok CLI)
XAI_API_KEY=
GROK_API_KEY=

# Gemini — required for pi web_search tool (pikit web-access)
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional extras
# OLLAMA_API_KEY=
# BRAVE_API_KEY=
